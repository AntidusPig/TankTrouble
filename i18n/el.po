msgid "PROP_0"
msgstr "Επισκευάζει δύο βαθμούς αντοχής. Τα άθικτα τανκ το αφήνουν για τους άλλους."

msgid "PROP_1"
msgstr "Απορροφά δύο μονάδες ζημιάς. Το λέιζερ διαπερνά την ασπίδα."

msgid "PROP_2"
msgstr "Γρήγορο βλήμα για χτυπήματα πριν στρίψει ή κρυφτεί ο αντίπαλος."

msgid "PROP_3"
msgstr "Ρίχνει τρία βλήματα σε διασπορά με μία φόρτιση."

msgid "PROP_4"
msgstr "Βαρύ και αργό βλήμα που προκαλεί δύο μονάδες ζημιάς σε άμεσο χτύπημα."

msgid "PROP_5"
msgstr "Φορτίζει για ένα δευτερόλεπτο και καταστρέφει κάθε τανκ στη δέσμη. Διαπερνά τοίχους και ακινητοποιεί τον σκοπευτή μέχρι το τέλος."

msgid "PROP_6"
msgstr "Εκρήγνυται σε επαφή ή όταν τελειώσει το φυτίλι. Ζημιώνει τα κοντινά τανκ. Οι τοίχοι παρέχουν κάλυψη."

msgid "BOT_0"
msgstr "Σταθερός στόχος με τρεις ζωές για εξάσκηση και δοκιμή αντικειμένων."

msgid "BOT_1"
msgstr "Σταθεροί κανόνες εναλλάσσουν καταδίωξη, βολή, αποφυγή και επισκευή."

msgid "BOT_2"
msgstr "Χρησιμοποιεί δέντρο προτεραιοτήτων και ελέγχει κινδύνους και ζημιές πριν επιτεθεί."

msgid "BOT_3"
msgstr "Σχεδιάζει ακολουθίες όπως υποχώρηση πριν την επισκευή ή εύρεση γραμμής βολής μετά τον επανεξοπλισμό."

msgid "BOT_4"
msgstr "Βαθμολογεί νόμιμες ενέργειες και εξετάζει την επόμενη κίνηση."

msgid "BOT_5"
msgstr "Μαθαίνει να ταξινομεί νόμιμες ενέργειες παίζοντας εναντίον παλαιότερων εκδόσεων του εαυτού του."

msgid "BOT_6"
msgstr "Ξέρει τη λύση και φτάνει στα κελιά για να τα αλλάζει με ένα βλήμα κάθε φορά."

